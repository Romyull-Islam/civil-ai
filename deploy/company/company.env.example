# CivilMate company edition settings. Copy to company.env (never share that file: it holds secrets).

# REQUIRED: a long random secret that encrypts stored API keys and signs sessions.
# Generate one with:  openssl rand -hex 32
CIVIL_AI_SECRET=

# Licence from your CivilMate provider (optional here; the administrator can paste it in Admin → Company instead).
CIVIL_AI_LICENSE=

# Answer only civil / construction questions; others are refused without calling any AI (saves money). on | off
CIVIL_AI_TOPIC_GUARD=on

# The company's own AI provider keys (optional here; the administrator can enter them in Admin → AI provider keys).
# Questions go directly from this server to the provider you choose, under your company's account and contract.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Private model server instead of (or as well as) cloud providers. With "docker compose --profile local-ai":
# OLLAMA_BASE_URL=http://ollama:11434/v1

# Email for password-reset codes through the company's own mail server (optional; without it the administrator
# resets passwords in Admin → Users).
# SMTP_HOST=mail.yourcompany.com
# SMTP_PORT=465
# SMTP_USER=civilmate@yourcompany.com
# SMTP_PASS=
# EMAIL_FROM=CivilMate <civilmate@yourcompany.com>
